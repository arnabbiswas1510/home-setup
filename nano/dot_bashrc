# ~/.bashrc: executed by bash(1) for non-login shells.
# Managed by chezmoi - portable across Linux and macOS

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

HISTCONTROL=ignoreboth
shopt -s histappend
HISTSIZE=5000
HISTFILESIZE=10000
shopt -s checkwinsize

# Clean prompt
PS1='[\u@\h \W]\$ '

# Color aliases
alias ls='ls --color=auto' 2>/dev/null || alias ls='ls -G'
alias grep='grep --color=auto'

# Standard User PATH
export PATH="$HOME/.local/bin:$HOME/.deno/bin:$PATH"

# Homebrew / Linuxbrew integration
if [ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [ -x "/opt/homebrew/bin/brew" ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x "/usr/local/bin/brew" ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

# Flatpak data dirs for graphical sessions on Linux
if [ -d "/var/lib/flatpak/exports/share" ]; then
    export XDG_DATA_DIRS="${HOME}/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
fi

# OpenAI-compatible LLM endpoint
export OPENAI_BASE_URL="http://192.168.1.50:11434/v1"
export OPENAI_API_KEY="ollama"
