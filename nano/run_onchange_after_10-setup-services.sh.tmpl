#!/bin/bash
# System & User service configuration script for chezmoi
# Data hash: {{ include ".chezmoidata/hosts.toml" | sha256sum }}

set -euo pipefail

HOST_KEY="{{ lower .chezmoi.hostname }}"
echo "==== Configuring System & User Services for ${HOST_KEY} ===="

{{ $hostData := index .hosts (lower .chezmoi.hostname) }}
{{ if $hostData }}

SUDO=""
if [ "$(id -u)" -ne 0 ]; then
    if sudo -n true 2>/dev/null; then
        SUDO="sudo"
    else
        echo "--> Sudo requires password authentication; skipping root-level systemd service setup."
    fi
fi

# System Services
{{ range $hostData.system_services }}
if [ -n "$SUDO" ] || [ "$(id -u)" -eq 0 ]; then
    echo "--> Enabling and starting system service: {{ . }}"
    $SUDO systemctl enable --now {{ . }} || true
fi
{{ end }}

# User Services
{{ range $hostData.user_services }}
echo "--> Enabling and starting user service: {{ . }}"
systemctl --user enable --now {{ . }} 2>/dev/null || true
{{ end }}

echo "==== Services configuration complete ===="
{{ end }}
