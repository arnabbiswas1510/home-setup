#!/bin/bash
export WEBKIT_DISABLE_COMPOSITING_MODE=1
if [ -x /usr/lib/libation/Libation ]; then
    exec /usr/lib/libation/Libation "$@"
elif [ -x /usr/bin/libation ]; then
    exec /usr/bin/libation "$@"
elif [ -x "$HOME/.local/lib/libation/Libation" ]; then
    exec "$HOME/.local/lib/libation/Libation" "$@"
else
    echo "Error: Libation binary not found." >&2
    exit 1
fi
