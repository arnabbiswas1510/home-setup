#!/usr/bin/env python3
"""
Daily Wallpaper Rotator - Indian Gods & Goddesses Collection
Rotates the desktop wallpaper daily from the IndianGods wallpaper repository.
Supports KDE Plasma (6 & 5), GNOME, macOS, and generic window managers.
Features Smart Ambient Canvas: automatically frames non-widescreen portraits
with color-matched atmospheric wings to guarantee deity crowns, halos, and
heads are never cropped by desktop displays.
"""

import os
import sys
import json
import random
import hashlib
import shutil
import subprocess
from pathlib import Path
from datetime import date

# Ensure virtualenv with Pillow is loaded if available
try:
    from PIL import Image, ImageFilter, ImageEnhance
except ImportError:
    venv_py = Path.home() / ".local" / "share" / "daily-wallpaper" / "venv" / "bin" / "python"
    if venv_py.exists() and sys.executable != str(venv_py):
        os.execv(str(venv_py), [str(venv_py)] + sys.argv)

SMB_HOST = "192.168.1.50"
SMB_SHARE = "photos"
SMB_SUBDIR = "Wallpapers/IndianGods"
SMB_USER = "pom"
SMB_PASS = "paro"

CACHE_DIR = Path.home() / ".cache" / "daily-wallpaper"
CACHE_INFO = CACHE_DIR / "current.json"
PROCESSED_DIR = CACHE_DIR / "processed"

IMAGE_EXTENSIONS = {".jpg", ".jpeg", ".png", ".webp"}

def log(msg: str):
    print(f"[DailyWallpaper] {msg}", flush=True)

def find_wallpaper_dir() -> Path:
    candidates = [
        Path.home() / "wallpapers" / "IndianGods",
        Path.home() / ".local" / "share" / "wallpapers" / "IndianGods",
        Path.home() / "Pictures" / "Wallpapers" / "IndianGods",
        Path("/mnt/photos/Wallpapers/IndianGods"),
    ]

    for p in candidates:
        if p.exists() and p.is_dir():
            imgs = [f for f in p.iterdir() if f.suffix.lower() in IMAGE_EXTENSIONS]
            if len(imgs) >= 1:
                return p

    # If no local directory found, create ~/wallpapers/IndianGods
    default_dir = Path.home() / "wallpapers" / "IndianGods"
    default_dir.mkdir(parents=True, exist_ok=True)
    
    # Try syncing from SMB if smbclient is available
    if shutil.which("smbclient"):
        log(f"No local wallpapers found. Attempting to sync from smb://{SMB_HOST}/{SMB_SHARE}/{SMB_SUBDIR}...")
        try:
            cmd = [
                "smbclient",
                f"//{SMB_HOST}/{SMB_SHARE}",
                f"-U{SMB_USER}%{SMB_PASS}",
                "-c",
                f"cd {SMB_SUBDIR}; prompt OFF; recurse ON; lcd {default_dir}; mget *"
            ]
            subprocess.run(cmd, timeout=90, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception as e:
            log(f"SMB sync skipped/failed: {e}")

    return default_dir

def get_images(wp_dir: Path):
    if not wp_dir.exists():
        return []
    files = [f for f in wp_dir.iterdir() if f.is_file() and f.suffix.lower() in IMAGE_EXTENSIONS]
    files.sort(key=lambda x: x.name.lower())
    return files

def create_smart_ambient_wallpaper(src_path: Path, target_size=(3840, 2160)) -> Path:
    """
    Inspects image aspect ratio. If not 16:9 widescreen (e.g. portrait or square),
    constructs a high-res 16:9 canvas with:
    - The complete, uncropped deity in the foreground with safe breathing margins
      so crowns, halos, and lotus feet are never cut off.
    - Soft realistic drop shadow for visual depth.
    - Beautiful ambient color-matched background blurred from the artwork itself.
    Caches result by file mtime and hash.
    """
    try:
        from PIL import Image, ImageFilter, ImageEnhance
    except ImportError:
        return src_path

    PROCESSED_DIR.mkdir(parents=True, exist_ok=True)

    try:
        mtime = src_path.stat().st_mtime
        key_str = f"{src_path.name}_{mtime}_{target_size[0]}x{target_size[1]}"
        cache_hash = hashlib.md5(key_str.encode("utf-8")).hexdigest()[:12]
        cached_file = PROCESSED_DIR / f"{cache_hash}_{src_path.stem}_ambient.jpg"

        if cached_file.exists():
            return cached_file

        with Image.open(src_path) as raw_im:
            im = raw_im.convert("RGBA")

        tw, th = target_size
        img_aspect = im.width / im.height

        # If already close to 16:9 widescreen (1.65 to 1.85), keep original
        if 1.65 <= img_aspect <= 1.85:
            return src_path

        # 1. Ambient Background: scale to fill canvas and blur heavily
        bg_scale = max(tw / im.width, th / im.height)
        bg_w, bg_h = int(im.width * bg_scale), int(im.height * bg_scale)
        bg = im.resize((bg_w, bg_h), Image.Resampling.LANCZOS)

        cx = (bg_w - tw) // 2
        cy = (bg_h - th) // 2
        bg = bg.crop((cx, cy, cx + tw, cy + th))
        bg = bg.filter(ImageFilter.GaussianBlur(radius=55))
        bg = ImageEnhance.Brightness(bg).enhance(0.55)
        bg = ImageEnhance.Color(bg).enhance(0.85)

        # 2. Foreground: scale deity with safe margins (5% top, 4% bottom)
        margin_top = 0.05
        margin_bottom = 0.04
        avail_h = int(th * (1.0 - margin_top - margin_bottom))
        avail_w = int(tw * 0.95)

        scale = min(avail_h / im.height, avail_w / im.width)
        fg_w = int(im.width * scale)
        fg_h = int(im.height * scale)
        fg = im.resize((fg_w, fg_h), Image.Resampling.LANCZOS)

        fg_x = (tw - fg_w) // 2
        fg_y = int(th * margin_top) + (avail_h - fg_h) // 2

        # 3. Soft drop shadow behind foreground
        shadow = Image.new("RGBA", (tw, th), (0, 0, 0, 0))
        shadow_box = Image.new("RGBA", (fg_w + 32, fg_h + 32), (0, 0, 0, 175))
        shadow.paste(shadow_box, (fg_x - 16, fg_y - 8))
        shadow = shadow.filter(ImageFilter.GaussianBlur(radius=28))

        # 4. Composite
        canvas = bg.copy()
        canvas.alpha_composite(shadow)
        canvas.alpha_composite(fg, (fg_x, fg_y))

        canvas.convert("RGB").save(cached_file, "JPEG", quality=95, optimize=True)
        log(f"Generated smart ambient canvas: {cached_file.name} (aspect: {img_aspect:.2f})")
        return cached_file
    except Exception as e:
        log(f"Warning: smart wallpaper generation failed ({e}), using original.")
        return src_path

def set_desktop_wallpaper(img_path: Path):
    path_str = str(img_path.resolve())
    applied_to = []

    # 1. KDE Plasma
    if shutil.which("plasma-apply-wallpaperimage"):
        try:
            res = subprocess.run(["plasma-apply-wallpaperimage", path_str],
                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            if res.returncode == 0:
                applied_to.append("KDE Plasma")
        except Exception as e:
            log(f"Warning calling plasma-apply-wallpaperimage: {e}")

    # 2. GNOME Desktop
    if shutil.which("gsettings"):
        try:
            uri = f"file://{path_str}"
            subprocess.run(["gsettings", "set", "org.gnome.desktop.background", "picture-uri", uri],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run(["gsettings", "set", "org.gnome.desktop.background", "picture-uri-dark", uri],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            applied_to.append("GNOME Desktop")
        except Exception:
            pass

    # 3. macOS
    if sys.platform == "darwin" and shutil.which("osascript"):
        try:
            script = f'tell application "Finder" to set desktop picture to POSIX file "{path_str}"'
            subprocess.run(["osascript", "-e", script], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            applied_to.append("macOS Finder")
        except Exception:
            pass

    # 4. X11 / Feh
    if shutil.which("feh") and os.environ.get("DISPLAY"):
        try:
            subprocess.run(["feh", "--bg-fill", path_str], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            applied_to.append("Feh (X11)")
        except Exception:
            pass

    return applied_to

def extract_deity_name(filename: str) -> str:
    tokens = filename.split("_")
    if len(tokens) >= 3 and tokens[0].lower() == "wikideity":
        return f"{tokens[1]} {tokens[2]}"
    elif len(tokens) >= 2 and tokens[0].lower() in ("myphotos", "starterpack"):
        return tokens[1]
    return "Indian Deity"

def main():
    force_random = "--random" in sys.argv or "-r" in sys.argv

    wp_dir = find_wallpaper_dir()
    images = get_images(wp_dir)

    if not images:
        log(f"Error: No wallpaper images found in {wp_dir}")
        sys.exit(1)

    today_str = date.today().isoformat()

    if force_random:
        chosen = random.choice(images)
        mode = "random"
    else:
        # Deterministic daily rotation: seed with today's date
        seed_val = int(hashlib.sha256(today_str.encode("utf-8")).hexdigest(), 16)
        chosen = images[seed_val % len(images)]
        mode = "daily"

    deity = extract_deity_name(chosen.name)
    log(f"Rotating main desktop wallpaper ({mode}):")
    log(f"  Deity: {deity}")
    log(f"  File: {chosen.name}")
    log(f"  Path: {chosen}")

    # Smart framing to guarantee no heads/crowns are cut off
    wallpaper_to_set = create_smart_ambient_wallpaper(chosen)
    log(f"  Applying: {wallpaper_to_set.name}")

    targets = set_desktop_wallpaper(wallpaper_to_set)
    if targets:
        log(f"Successfully applied wallpaper for: {', '.join(targets)}")
    else:
        log(f"Wallpaper selected ({chosen.name}), but no supported desktop environment CLI was active.")

    # Record current state
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    with open(CACHE_INFO, "w", encoding="utf-8") as f:
        json.dump({
            "date": today_str,
            "filename": chosen.name,
            "path": str(chosen),
            "applied_path": str(wallpaper_to_set),
            "deity": deity
        }, f, indent=2)

if __name__ == "__main__":
    main()
