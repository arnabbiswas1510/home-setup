#!/usr/bin/env python3
"""
FreshBing - Daily Bing Picture of the Day Lock Screen Wallpaper Updater
Portably downloads the daily UHD Bing wallpaper and configures the lock screen.
Supports KDE Plasma (6 & 5), GNOME, and generic screenlockers.
"""

import os
import sys
import json
import shutil
import urllib.request
import subprocess
from pathlib import Path
from datetime import datetime

BING_API = "https://www.bing.com/HPImageArchive.aspx?format=js&idx=0&n=1&mkt=en-US"
CACHE_DIR = Path.home() / ".cache" / "freshbing"
CACHE_FILE = CACHE_DIR / "bing_potd.jpg"
METADATA_FILE = CACHE_DIR / "bing_potd.json"
ARCHIVE_DIR = CACHE_DIR / "archive"

def log(msg: str):
    print(f"[FreshBing] {msg}", flush=True)

def fetch_bing_metadata():
    headers = {
        "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
    }
    req = urllib.request.Request(BING_API, headers=headers)
    with urllib.request.urlopen(req, timeout=20) as resp:
        data = json.loads(resp.read().decode("utf-8"))
    
    if not data.get("images"):
        raise ValueError("No images found in Bing API response")
    
    img_data = data["images"][0]
    return img_data

def download_image(img_data):
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    ARCHIVE_DIR.mkdir(parents=True, exist_ok=True)
    
    urlbase = img_data.get("urlbase")
    fallback_url = img_data.get("url")
    
    headers = {
        "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
    }

    # Try UHD first, then standard resolution
    candidate_urls = []
    if urlbase:
        candidate_urls.append(f"https://www.bing.com{urlbase}_UHD.jpg")
        candidate_urls.append(f"https://www.bing.com{urlbase}_1920x1080.jpg")
    if fallback_url:
        candidate_urls.append(f"https://www.bing.com{fallback_url}")

    downloaded = False
    for u in candidate_urls:
        try:
            req = urllib.request.Request(u, headers=headers)
            with urllib.request.urlopen(req, timeout=30) as resp:
                if resp.status == 200:
                    content = resp.read()
                    if len(content) > 50000:
                        with open(CACHE_FILE, "wb") as f:
                            f.write(content)
                        downloaded = True
                        break
        except Exception:
            continue

    if not downloaded:
        raise RuntimeError("Failed to download Bing daily image from candidate URLs")

    # Save metadata
    with open(METADATA_FILE, "w", encoding="utf-8") as f:
        json.dump(img_data, f, indent=2)

    # Archive copy by date
    startdate = img_data.get("startdate", datetime.now().strftime("%Y%m%d"))
    archive_file = ARCHIVE_DIR / f"{startdate}_bing.jpg"
    shutil.copy2(CACHE_FILE, archive_file)

    return CACHE_FILE

def set_lockscreen_wallpaper(image_path: Path):
    path_str = str(image_path.resolve())
    actions_taken = []

    # 1. KDE Plasma 6
    if shutil.which("kwriteconfig6"):
        try:
            subprocess.run([
                "kwriteconfig6", "--file", "kscreenlockerrc",
                "--group", "Greeter", "--key", "wallpaperPlugin", "org.kde.image"
            ], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run([
                "kwriteconfig6", "--file", "kscreenlockerrc",
                "--group", "Greeter", "--group", "Wallpaper", "--group", "org.kde.image", "--group", "General",
                "--key", "Image", path_str
            ], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run([
                "kwriteconfig6", "--file", "kscreenlockerrc",
                "--group", "Greeter", "--group", "Wallpaper", "--group", "org.kde.image", "--group", "General",
                "--key", "PreviewImage", path_str
            ], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            actions_taken.append("KDE Plasma 6 kscreenlockerrc")
        except Exception as e:
            log(f"Warning setting KDE 6 lockscreen: {e}")

    # 2. KDE Plasma 5
    elif shutil.which("kwriteconfig5"):
        try:
            subprocess.run([
                "kwriteconfig5", "--file", "kscreenlockerrc",
                "--group", "Greeter", "--key", "wallpaperPlugin", "org.kde.image"
            ], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run([
                "kwriteconfig5", "--file", "kscreenlockerrc",
                "--group", "Greeter", "--group", "Wallpaper", "--group", "org.kde.image", "--group", "General",
                "--key", "Image", path_str
            ], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run([
                "kwriteconfig5", "--file", "kscreenlockerrc",
                "--group", "Greeter", "--group", "Wallpaper", "--group", "org.kde.image", "--group", "General",
                "--key", "PreviewImage", path_str
            ], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            actions_taken.append("KDE Plasma 5 kscreenlockerrc")
        except Exception as e:
            log(f"Warning setting KDE 5 lockscreen: {e}")

    # 3. GNOME / GDM
    if shutil.which("gsettings"):
        try:
            uri = f"file://{path_str}"
            subprocess.run(["gsettings", "set", "org.gnome.desktop.screensaver", "picture-uri", uri],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run(["gsettings", "set", "org.gnome.desktop.screensaver", "picture-uri-dark", uri],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            actions_taken.append("GNOME screensaver")
        except Exception:
            pass

    # 4. Universal symlink for swaylock / i3lock / hyprlock
    symlink_path = CACHE_DIR / "lockscreen_wallpaper.jpg"
    try:
        if symlink_path.is_symlink() or symlink_path.exists():
            symlink_path.unlink()
        symlink_path.symlink_to(image_path)
        actions_taken.append("Generic lockscreen symlink")
    except Exception:
        pass

    return actions_taken

def main():
    try:
        log("Fetching today's Bing Picture of the Day...")
        meta = fetch_bing_metadata()
        title = meta.get("title", "Untitled")
        copyright_info = meta.get("copyright", "")
        log(f"Title: \"{title}\"")
        if copyright_info:
            log(f"Copyright: {copyright_info}")

        img_file = download_image(meta)
        size_mb = os.path.getsize(img_file) / (1024 * 1024)
        log(f"Saved wallpaper to {img_file} ({size_mb:.2f} MB)")

        targets = set_lockscreen_wallpaper(img_file)
        if targets:
            log(f"Lock screen wallpaper successfully updated for: {', '.join(targets)}")
        else:
            log("Lock screen image cached; no supported lockscreen daemon detected.")

    except Exception as err:
        log(f"Error updating Bing lockscreen wallpaper: {err}")
        sys.exit(1)

if __name__ == "__main__":
    main()
