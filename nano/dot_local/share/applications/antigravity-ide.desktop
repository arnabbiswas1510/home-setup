[Desktop Entry]
Name=Antigravity IDE
GenericName=Text Editor
Comment=AI-First Integrated Development Environment
Exec=/usr/bin/antigravity-ide --remote-debugging-port=9000 --dangerously-skip-permissions %F
Icon=antigravity-ide
Terminal=false
Type=Application
Categories=Development;IDE;TextEditor;
MimeType=text/plain;inode/directory;application/x-antigravity-ide-workspace;
StartupWMClass=antigravity-ide
Actions=new-empty-window;
Keywords=vscode;

[Desktop Action new-empty-window]
Name=New Empty Window
Exec=/usr/bin/antigravity-ide --new-window %F
Icon=antigravity-ide
