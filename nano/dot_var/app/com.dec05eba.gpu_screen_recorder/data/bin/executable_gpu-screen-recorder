#!/usr/bin/env bash

# Pass queries through directly
if [[ "$*" =~ --(info|version|list|help) ]]; then
    exec /app/bin/gpu-screen-recorder "$@"
fi

ARGS=()
SKIP_NEXT=0

for ((i=1; i<=$#; i++)); do
    arg="${!i}"
    if [ $SKIP_NEXT -eq 1 ]; then
        SKIP_NEXT=0
        continue
    fi

    # Strip resolution downscaling override (-s WxH)
    if [ "$arg" = "-s" ]; then
        SKIP_NEXT=1
        continue
    fi

    # Enforce full-screen recording if portal or focused window capture was requested
    if [ "$arg" = "-w" ]; then
        next_idx=$((i+1))
        next_arg="${!next_idx}"
        if [ "$next_arg" = "portal" ] || [ "$next_arg" = "focused" ]; then
            ARGS+=("-w" "screen")
        else
            ARGS+=("-w" "$next_arg")
        fi
        SKIP_NEXT=1
        continue
    fi

    # Override codec to HEVC (H.265) for maximum quality and minimal file size
    if [ "$arg" = "-k" ]; then
        ARGS+=("-k" "hevc")
        SKIP_NEXT=1
        continue
    fi

    # Enforce 30 FPS for reduced file size
    if [ "$arg" = "-f" ]; then
        ARGS+=("-f" "30")
        SKIP_NEXT=1
        continue
    fi

    # Ensure silent_sink.monitor is used for audio
    if [ "$arg" = "-a" ]; then
        ARGS+=("-a" "silent_sink.monitor")
        SKIP_NEXT=1
        continue
    fi

    ARGS+=("$arg")
done

# Ensure -w screen
if [[ ! " ${ARGS[*]} " =~ " -w " ]]; then
    ARGS+=("-w" "screen")
fi

# Ensure 30 FPS
if [[ ! " ${ARGS[*]} " =~ " -f " ]]; then
    ARGS+=("-f" "30")
fi

# Ensure HEVC codec
if [[ ! " ${ARGS[*]} " =~ " -k " ]]; then
    ARGS+=("-k" "hevc")
fi

# Ensure silent sink audio
if [[ ! " ${ARGS[*]} " =~ " -a " ]]; then
    ARGS+=("-a" "silent_sink.monitor")
fi

exec /app/bin/gpu-screen-recorder "${ARGS[@]}"
