# IBKR Live Account (credentials for ib-gateway container)
IBKR_ACCOUNT=your_account_id
IBKR_LIVE_USER=your_ibkr_user
IBKR_LIVE_PASS=your_ibkr_pass
IBKR_TOTP_SECRET=your_totp_secret

# IBKR Flex Query (cash deposit sync for performance report)
IBKR_FLEX_TOKEN=your_flex_token
IBKR_FLEX_QUERY_ID=your_query_id
IBKR_FLEX_EXEC_QUERY_ID=your_exec_query_id

# Supabase (database)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

# FMP (Financial Modeling Prep — market data for technical screener)
FMP_API_KEY=your_fmp_api_key

# OpenAI (AI trigger ranking)
OPENAI_API_KEY=your_openai_api_key

# Telegram (trade alerts and notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_IDS=your_chat_ids

# Portfolio & risk settings
MAX_POSITIONS=5
MIN_POSITION_SIZE=5000.0
STOP_LOSS_PCT=0.07
EARLY_LOSS_STOP_PCT=0.02
INTRADAY_MINIMISER_START_DAY=2
PLATEAU_DAYS=10
COOLING_OFF_DAYS=3

# Buy gating
TRIGGER_LOOKBACK_DAYS=3
MAX_PIVOT_EXTENSION=0.05
MIN_TRIGGER_SCORE=60
MIN_PRE_BREAKOUT_SCORE=65
MIN_RELAXED_TRIGGER_SCORE=58

# Moving average exit
EXIT_MA_TRIGGER_ENABLED=true
EXIT_MA_TYPE=EMA
EXIT_MA_WINDOW=21
EXIT_MA_BUFFER_PCT=0.01
EXIT_MA_EOD_ONLY=true

# Technical screener
SMA_WINDOW=50
VOLUME_SURGE_MIN=1.50
ROLLING_HIGH_WINDOW=252
PIVOT_PROXIMITY=0.95
TRIGGER_PRUNE_DAYS=56
RS_MIN_GATE=50
PRE_BREAKOUT_SCORE_BOOST=0
DAILY_TRIGGER_TARGET=4
RELAXED_PRE_BREAKOUT_PROXIMITY=0.10
RELAXED_PRE_BREAKOUT_VOL_MAX=1.10
RELAXED_PRE_BREAKOUT_UPTREND_MIN=2
RELAXED_RS_MIN_GATE=50
