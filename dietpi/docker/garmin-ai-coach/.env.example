# Environment variables for garmin-ai-coach (example only)
# Copy to .env and fill in real values. Do NOT commit real secrets.

# LLM providers (use at least one)
GOOGLE_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=...
DEEPSEEK_API_KEY=...

# Garmin Credentials
GARMIN_EMAIL=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password

# Athlete Profile overrides
ATHLETE_NAME=Arnab
ATHLETE_AGE=53
TARGET_GOAL=base_building
SYNC_CALENDAR=true

# AI Mode: cost_effective | standard | pro | development
AI_MODE=cost_effective
LOG_LEVEL=INFO

# Daemon / Poller
POLL_INTERVAL_SECONDS=3600
FORCE_ANALYTICS=false

# Logseq SSH direct-write configuration
LOGSEQ_SSH_HOST=192.168.1.50
LOGSEQ_SSH_USER=pom
LOGSEQ_SSH_PORT=22
LOGSEQ_SSH_KEY_PATH=/root/.ssh/id_ed25519
LOGSEQ_GRAPH_PATH=/home/pom/Logseq_Brain/journals
