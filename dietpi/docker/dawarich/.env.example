# Rails environment: development, staging, or production
RAILS_ENV=production

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_dawarich_postgres_password

# Database name
POSTGRES_DB=dawarich_production

# Database connection settings (used by Rails app)
DATABASE_HOST=dawarich_db
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_dawarich_postgres_password
DATABASE_NAME=dawarich_production

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis connection URL
REDIS_URL=redis://dawarich_redis:6379

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Port to expose the application on (using 3020 to avoid conflict with ntopng on 3000)
DAWARICH_APP_PORT=3020

# Application hosts (comma-separated)
APPLICATION_HOSTS=localhost,::1,127.0.0.1,dietpi.local,192.168.1.50

# Application protocol (http or https)
APPLICATION_PROTOCOL=http

# Time zone
TIME_ZONE=America/New_York

# Self-hosted flag (true for docker deployments)
SELF_HOSTED=true

# Store geodata (reverse geocoding results)
STORE_GEODATA=true

# Storage backend (local or s3)
STORAGE_BACKEND=local

# =============================================================================
# SECURITY
# =============================================================================

# Secret key base for production/staging (generate with: openssl rand -hex 64)
SECRET_KEY_BASE=your_generated_secret_key_base_here

# =============================================================================
# BACKGROUND JOBS
# =============================================================================

# Sidekiq concurrency (number of threads)
BACKGROUND_PROCESSING_CONCURRENCY=5

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

PROMETHEUS_EXPORTER_ENABLED=false
RAILS_LOG_TO_STDOUT=true
LOG_MAX_SIZE=100m
LOG_MAX_FILE=5

# =============================================================================
# RESOURCE LIMITS
# =============================================================================

APP_CPU_LIMIT=0.50
APP_MEMORY_LIMIT=2G
