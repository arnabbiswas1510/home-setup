# =============================================================================
# DietPi Server Main Docker Environment Configuration (.env)
# Copy to .env and fill in actual values. DO NOT commit actual secrets.
# =============================================================================

# Security (generate with: openssl rand -hex 32)
SECRET_KEY=your_random_hex_secret_key_here
NETDATA_CLAIM_TOKEN=your_netdata_claim_token_here

# Immich version (use "release" for latest stable)
IMMICH_VERSION=release

# Media storage location on host
UPLOAD_LOCATION=/mnt/photos

# Immich PostgreSQL Database settings
DB_USERNAME=immich
DB_PASSWORD=your_db_password_here
DB_DATABASE_NAME=immich
DB_DATA_LOCATION=/home/dietpi/docker/config/immich/db-data

# n8n Settings
N8N_SECURE_COOKIE=false

# MariaDB Container Settings
DB_USER_ID=1000
DB_GROUP_ID=1000
MYSQL_ROOT_PASSWORD=your_mariadb_root_password
MYSQL_DATABASE=booklore

# AI Keys & Integrations
MY_OPENROUTER_KEY=your_openrouter_api_key_here
OBSIDIAN_VAULT_PATH="/home/dietpi/obsidian/Vault"
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GARMIN_EMAIL="your_garmin_email@example.com"
GARMIN_PASSWORD="your_garmin_password"

# Enabled Compose Profiles on Main Host
COMPOSE_PROFILES=trading,health

# NordVPN Credentials for Gluetun
NORDVPN_USER=your_nordvpn_user_token
NORDVPN_PASSWORD=your_nordvpn_password_token
